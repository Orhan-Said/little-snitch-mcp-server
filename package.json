{
  "name": "little-snitch-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for the Little Snitch macOS firewall: read rules and traffic, and make guarded changes, through the official littlesnitch command-line tool.",
  "license": "MIT",
  "author": "Orhan Said",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orhan-Said/little-snitch-mcp-server.git"
  },
  "homepage": "https://github.com/Orhan-Said/little-snitch-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Orhan-Said/little-snitch-mcp-server/issues"
  },
  "type": "module",
  "bin": {
    "little-snitch-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    ".claude-plugin/plugin.json",
    ".codex-plugin",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "vitest run tests/e2e/package.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "version": "node scripts/sync-version.mjs",
    "live-check": "node scripts/live-check.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "little-snitch",
    "firewall",
    "macos",
    "network-monitor"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lossless-json": "^4.3.4",
    "zod": "^4.6.7"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/sdk",
    "lossless-json",
    "zod"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
